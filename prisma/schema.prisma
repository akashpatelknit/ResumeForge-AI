generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Resume {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id")
  title             String
  templateId        String            @map("template_id")
  data              Json
  // Raw LaTeX source for the Overleaf-style editor (app/(app)/builder/[resumeId]/latex).
  // Kept as its own column rather than a field inside `data` — it's a fundamentally
  // different kind of content (freeform text vs. structured form JSON) and doesn't
  // benefit from JSON querying. Tradeoff: needs a migration instead of being schema-free.
  latexSource       String?           @map("latex_source")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  coverLetters      CoverLetter[]
  analytics         ResumeAnalytics[]
  quickApplyEntries QuickApplyEntry[]
  savedJobs         SavedJob[]
  defaultForOutreachSettings UserOutreachSettings[]

  @@index([userId])
  @@map("resumes")
}

model CoverLetter {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id")
  resumeId    String   @map("resume_id") @db.Uuid
  title       String
  content     String
  jobTitle    String?  @map("job_title")
  companyName String?  @map("company_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("cover_letters")
}

model ResumeAnalytics {
  id        String   @id @default(uuid()) @db.Uuid
  resumeId  String   @map("resume_id") @db.Uuid
  eventType String   @map("event_type")
  eventData Json?    @map("event_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId])
  @@map("resume_analytics")
}

model JobApplication {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id")
  company        String
  role           String
  status         String    @default("wishlist")
  appliedDate    DateTime? @map("applied_date") @db.Timestamptz(6)
  matchScore     Int?      @map("match_score")
  tags           String[]  @default([])
  location       String?
  salary         String?
  notes          String?
  url            String?
  jobDescription String?   @map("job_description")
  // Where this entry originated — surfaced nowhere in the board UI, kept
  // only so a smart-prompt-created entry stays traceable from "manual".
  source         String    @default("manual")
  resumeId       String?   @map("resume_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("job_applications")
}

model UserPreferences {
  userId      String   @id @map("user_id")
  preferences Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_preferences")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id")
  razorpaySubscriptionId String?            @unique @map("razorpay_subscription_id")
  razorpayCustomerId     String?            @map("razorpay_customer_id")
  status                 SubscriptionStatus @default(trialing)
  currentPeriodEnd       DateTime?          @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt            DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscriptions")
}

// Single-row table (there will only ever be one Admin) backing the
// standalone admin dashboard's own login (app/api/admin/login/route.ts).
// Deliberately has no relation to Clerk's User — admin auth is a fully
// separate system, see lib/admin/session.ts.
model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}

// Keyed by Clerk's userId (not a relation — Clerk owns that identity, this
// table only tracks the one flag the admin dashboard needs to enforce).
// Absence of a row means "not blocked" — only written when an admin
// actually blocks someone, see app/api/admin/users/[userId]/block/route.ts.
model UserStatus {
  userId        String    @id @map("user_id")
  isBlocked     Boolean   @default(false) @map("is_blocked")
  blockedAt     DateTime? @map("blocked_at") @db.Timestamptz(6)
  blockedReason String?   @map("blocked_reason")
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_status")
}

// Single-row table (id is always the literal "singleton") holding the
// values that used to be hardcoded constants (FREE_RESUME_LIMIT,
// FREE_AI_GENERATION_LIMIT) so the admin Plans & Pricing screen can change
// them without a deploy. See lib/subscription/planConfig.ts.
model PlanConfig {
  id                    String   @id @default("singleton")
  proPriceInr           Int      @default(149) @map("pro_price_inr")
  freeResumeLimit       Int      @default(3) @map("free_resume_limit")
  freeAiGenerationLimit Int      @default(15) @map("free_ai_generation_limit")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("plan_config")
}

// Admin-managed overlay on top of the static template registry
// (config/templates.ts) — keyed by that file's Template.id. Metadata only
// (see lib/admin/templates.ts); the consumer-facing template selector does
// not currently read this table, see the admin Templates page for why.
model TemplateMeta {
  templateId String   @id @map("template_id")
  isPro      Boolean  @default(false) @map("is_pro")
  isActive   Boolean  @default(true) @map("is_active")
  isFeatured Boolean  @default(false) @map("is_featured")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("template_meta")
}

// One row per user per calendar month (e.g. "2026-08") — resets naturally
// by simply starting a new row rather than a scheduled job zeroing a
// counter. Only free-tier usage is ever recorded here (see
// lib/subscription/checkUsageLimit.ts) since it exists purely to enforce
// the free-tier AI generation cap.
model UsageCounter {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id")
  month             String
  aiGenerationsUsed Int      @default(0) @map("ai_generations_used")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, month])
  @@map("usage_counters")
}

// One Gmail account per user, connected via a separate OAuth 2.0 flow from
// Clerk (Clerk owns login identity; this owns send-mail authorization).
// Keyed directly by Clerk's userId — same "no Prisma User model" pattern as
// UserStatus/UserPreferences above, not a relational FK. accessToken/
// refreshToken are AES-256-GCM ciphertext (see lib/crypto/tokenCipher.ts),
// never plaintext, since a DB leak would otherwise hand over live
// send-as-this-person credentials.
model GmailAccount {
  userId         String   @id @map("user_id")
  email          String
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  tokenExpiresAt DateTime @map("token_expires_at") @db.Timestamptz(6)
  connectedAt    DateTime @default(now()) @map("connected_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("gmail_accounts")
}

enum QuickApplyStatus {
  draft
  generated
  sent
  failed
}

// Which of the two resume sources (Resume vs UploadedResume, see below) a
// QuickApplyEntry/SavedJob row's attachment was picked from. Kept as an
// explicit enum alongside two nullable FK columns (resumeId/uploadedResumeId
// — exactly one set at a time, enforced at the application layer, not a DB
// CHECK constraint) rather than collapsing to a single polymorphic id column,
// so both sides keep a real foreign key / cascade behavior instead of one of
// them being an unenforced loose UUID string.
enum ResumeSourceType {
  builder
  uploaded
}

// Which exact template (see lib/ai/buildColdApplicationPrompt.ts /
// buildReferralRequestPrompt.ts) the generated email followed.
// referral_request only ever actually applies when jobId is also set —
// generateQuickApplyEmail falls back to cold_application otherwise, but the
// user's selected toggle position is still persisted as-is so re-opening a
// draft shows what they had chosen.
enum QuickApplyMessageType {
  cold_application
  referral_request
}

// One row per Quick Apply attempt (components/outreach/QuickApplyModal.tsx).
// A single row is reused across generate -> regenerate -> send for the same
// modal session (the frontend holds the id after the first successful
// generate/draft-save) rather than one row per click, so regenerating
// doesn't pile up duplicates.
model QuickApplyEntry {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id")
  recipientEmail   String                @map("recipient_email")
  companyName      String                @map("company_name")
  roleTitle        String                @map("role_title")
  pastedContext    String?               @map("pasted_context")
  messageType      QuickApplyMessageType @default(cold_application) @map("message_type")
  // Extracted from pastedContext (see buildQuickApplyExtractPrompt.ts) or
  // typed in manually — unlocks the Referral Request template when set.
  jobId            String?               @map("job_id")
  // Exactly one of resumeId / uploadedResumeId is set, per resumeSourceType.
  resumeSourceType ResumeSourceType      @default(builder) @map("resume_source_type")
  resumeId         String?               @map("resume_id") @db.Uuid
  uploadedResumeId String?               @map("uploaded_resume_id") @db.Uuid
  generatedSubject String?               @map("generated_subject")
  generatedBody    String?               @map("generated_body")
  status           QuickApplyStatus      @default(draft)
  gmailMessageId   String?               @map("gmail_message_id")
  // Not in the original spec — added so a "failed" row can carry *why* it
  // failed (expired token / rate limit / invalid recipient / ...) for the
  // frontend to show something more useful than a generic error.
  errorMessage     String?               @map("error_message")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  sentAt           DateTime?             @map("sent_at") @db.Timestamptz(6)
  resume           Resume?               @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  uploadedResume   UploadedResume?       @relation(fields: [uploadedResumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("quick_apply_entries")
}

// A raw, unparsed PDF a user uploaded as an alternative to a ResumeForge-
// built Resume (see "Resume to Attach" in QuickApplyModal/GenerateEmailPanel)
// — no structured JSON behind it, just a stored file. Kept as its own model
// rather than a nullable-data row on Resume since the two have almost
// nothing in common (no template, no builder form, nothing to render/edit).
model UploadedResume {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id")
  fileName          String            @map("file_name")
  fileUrl           String            @map("file_url")
  fileSizeBytes     Int               @map("file_size_bytes")
  uploadedAt        DateTime          @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  // Text extracted from the PDF, cached lazily on first use (Quick Apply /
  // scheduled outreach generation) so the same upload never gets re-fetched
  // from blob storage and re-parsed on every subsequent send. Null until
  // that first use — an upload nobody ever generates an email for never
  // pays the parsing cost at all. See lib/db/uploadedResumes.ts.
  parsedText        String?           @map("parsed_text")
  quickApplyEntries QuickApplyEntry[]
  savedJobs         SavedJob[]
  defaultForOutreachSettings UserOutreachSettings[]

  @@index([userId])
  @@map("uploaded_resumes")
}

enum JobSource {
  greenhouse
  manual
}

// Job Discovery is a live-fetch feature (Greenhouse's public API, cached in
// Redis — see lib/jobs/greenhouseClient.ts) — this table is deliberately
// NOT a bulk store of every job seen. A row only exists once a user acts on
// a job (bookmark / queue) or types one in manually. externalJobId is the
// Greenhouse numeric job id (as a string) for source=greenhouse, and always
// null for source=manual — the unique constraint below relies on Postgres
// treating each NULL as distinct, so multiple manual rows per user never
// collide on it.
// Outreach type/status naming intentionally mirrors the existing frontend
// mock types in components/outreach/outreachData.ts (OutreachType /
// OutreachStatus) so the Cold Outreach Dashboard's badges/filters keep
// working unmodified — "quick_apply" here maps to that file's "quickApply"
// at the API boundary (app/api/outreach/queue/route.ts), since Prisma enum
// values can't contain a bare camelCase word the same way TS unions can but
// this schema otherwise uses snake_case for multi-word enum values.
enum OutreachType {
  cold
  general
  referral
  quick_apply
}

enum OutreachStatus {
  draft
  generated
  approved
  scheduled
  generating
  sending
  sent
  replied
  bounced
  failed
}

model SavedJob {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id")
  source         JobSource
  externalJobId  String?   @map("external_job_id")
  company        String
  jobTitle       String    @map("job_title")
  location       String?
  jobDescription String    @map("job_description")
  requisitionId  String?   @map("requisition_id")
  contactEmails  String[]  @default([]) @map("contact_emails")
  isBookmarked   Boolean   @default(false) @map("is_bookmarked")
  isQueued       Boolean   @default(false) @map("is_queued")
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Cold Outreach Dashboard fields — null until the job is actually queued
  // (outreachStatus/lastActivityAt) or until the user picks a type via the
  // Generate & Review panel (outreachType), which this pass doesn't wire
  // saving for (that panel stays mock per an earlier, still-standing scope
  // boundary) — so outreachType can legitimately stay null indefinitely.
  outreachType      OutreachType?   @map("outreach_type")
  outreachStatus    OutreachStatus? @map("outreach_status")
  scheduledSendTime DateTime?       @map("scheduled_send_time") @db.Timestamptz(6)
  lastActivityAt    DateTime?       @map("last_activity_at") @db.Timestamptz(6)

  // Schedule Outreach fields — resumeId is pinned at schedule time (the user's
  // most-recently-updated resume) so the cron sender uses the same resume it
  // was scheduled against, even if the user edits/creates other resumes later.
  // resumeSourceType/uploadedResumeId mirror QuickApplyEntry's fields (see
  // ResumeSourceType above) so the cron sender (app/api/cron/process-outreach-
  // queue) can branch the same way — no UI currently sets uploadedResumeId
  // here (the "Approve & Schedule" flow only ever auto-pins a builder
  // Resume), but the cron sender still honors it if one is ever set.
  resumeSourceType ResumeSourceType @default(builder) @map("resume_source_type")
  resumeId         String?          @map("resume_id") @db.Uuid
  uploadedResumeId String?          @map("uploaded_resume_id") @db.Uuid
  generatedSubject String?          @map("generated_subject")
  generatedBody    String?          @map("generated_body")
  sendAttempts     Int              @default(0) @map("send_attempts")
  lastError        String?          @map("last_error")
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz(6)
  gmailMessageIds  String[]         @default([]) @map("gmail_message_ids")

  resume         Resume?         @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  uploadedResume UploadedResume? @relation(fields: [uploadedResumeId], references: [id], onDelete: SetNull)

  @@unique([userId, externalJobId])
  @@index([userId])
  @@index([outreachStatus, scheduledSendTime])
  @@map("saved_jobs")
}

model UserOutreachSettings {
  userId           String   @id @map("user_id")
  dailySendLimit   Int      @default(15) @map("daily_send_limit")
  sendWindowStart  String   @default("09:00") @map("send_window_start")
  sendWindowEnd    String   @default("18:00") @map("send_window_end")
  // When true, sendWindowStart is ignored at schedule-computation time in
  // favor of the actual current time — "Start Now" on the settings page.
  // Deliberately NOT implemented as a one-time snapshot of the clock time
  // into sendWindowStart: that would mean re-using a saved "Start Now"
  // setting days later incorrectly reuses the time it was first saved at,
  // instead of actually starting immediately each time it's used.
  sendWindowStartsNow Boolean @default(false) @map("send_window_starts_now")
  weekdaysOnly     Boolean  @default(true) @map("weekdays_only")
  jitterEnabled    Boolean  @default(true) @map("jitter_enabled")
  jitterMinSeconds Int      @default(30) @map("jitter_min_seconds")
  jitterMaxSeconds Int      @default(300) @map("jitter_max_seconds")

  // Default resume attached to scheduled outreach emails — same
  // builder-vs-uploaded choice as Quick Apply and SavedJob itself (see
  // components/outreach/ResumeAttachPicker.tsx, reused on the Send
  // Scheduler settings page). /api/outreach/schedule falls back to the
  // user's most-recently-updated resume when neither is set, so this is
  // opt-in, not a required setup step.
  defaultResumeSourceType ResumeSourceType? @map("default_resume_source_type")
  defaultResumeId         String?           @map("default_resume_id") @db.Uuid
  defaultUploadedResumeId String?           @map("default_uploaded_resume_id") @db.Uuid
  defaultResume           Resume?           @relation(fields: [defaultResumeId], references: [id], onDelete: SetNull)
  defaultUploadedResume   UploadedResume?   @relation(fields: [defaultUploadedResumeId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_outreach_settings")
}

// One row per call made through the AI Gateway (lib/ai/gateway.ts) — every
// AI feature in the app, success or failure. Keyed by Clerk userId same as
// UsageCounter/UserOutreachSettings above (no Prisma User model / FK); an
// unauthenticated caller (e.g. the pre-login resume parser) is logged as
// "anon:<anonId>" rather than a null userId, so every row still has a
// queryable per-actor identifier.
model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id")
  feature      String
  model        String
  // Estimated from character counts (~4 chars/token), not the provider's
  // actual usage metadata — see lib/ai/gateway.ts. Null when the call failed
  // before a prompt/response existed to estimate from.
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  status       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([feature])
  @@map("ai_usage_logs")
}
